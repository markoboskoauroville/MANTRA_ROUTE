<?xml version="1.0" encoding="utf-8"?>
<!--
  A thumb sized for a thumb. 56dp is the size a finger can find and drag without hunting;
  the platform default is roughly half that and was never meant for a control that is the
  whole point of the screen.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/amber" />
    <size android:width="56dp" android:height="56dp" />
</shape>
