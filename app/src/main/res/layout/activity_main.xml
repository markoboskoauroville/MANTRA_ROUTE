<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_scroll"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/sand"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="@color/slate_ink"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Volume lives in Quick Settings. Pull the shade down twice, tap the pencil, and drag the tiles you want into the panel."
            android:textColor="@color/slate_ink"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <TextView
                android:id="@+id/dnd_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@color/slate"
                android:gravity="center"
                android:minHeight="64dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="Do Not Disturb access"
                android:textColor="@color/sand"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/copy_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@color/slate"
                android:gravity="center"
                android:minHeight="64dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="Copy the report"
                android:textColor="@color/sand"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Volume"
            android:textColor="@color/sand"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Android has no per-speaker volume. Each of these is a separate stream with its own level."
            android:textColor="@color/slate_ink"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/volume_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Output mix"
            android:textColor="@color/sand"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="One meter, not five: Android exposes a single output mix and cannot say which stream a sample came from. Boost is global for the same reason."
            android:textColor="@color/slate_ink"
            android:textSize="12sp" />

        <com.mantra.route.VuView
            android:id="@+id/vu"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/vu_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/slate_ink"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <TextView
                android:id="@+id/normalize_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:background="@color/slate"
                android:gravity="center"
                android:minHeight="56dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="Normalize"
                android:textColor="@color/amber"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/boost_check"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Boost"
                android:textColor="@color/sand"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="20dp"
            android:text="Mantra Productions"
            android:textColor="@color/slate_ink"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
