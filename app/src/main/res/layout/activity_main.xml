<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_scroll"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- §10: two ends and a middle, so the version sits at the far edge rather than
             piling into the corner beside the title. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/sand"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="@color/slate_ink"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/shizuku_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="14sp" />

        

        <!-- 2 x 2. §10 says never size a WORD by a fraction of the line; these are BOXES
             sharing the width equally, and each box wraps its own text over as many lines as it
             needs. minHeight keeps the four boxes the same size whatever the labels say. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <TextView
                android:id="@+id/notif_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/slate"
                android:gravity="center"
                android:minHeight="64dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="Show the panel"
                android:textColor="@color/sand"
                android:textSize="14sp" />

            <View android:layout_width="10dp" android:layout_height="1dp" />

            <TextView
                android:id="@+id/probe_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/slate"
                android:gravity="center"
                android:minHeight="64dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="Probe this phone"
                android:textColor="@color/amber"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <TextView
                android:id="@+id/copy_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/slate"
                android:gravity="center"
                android:minHeight="64dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="Copy the report"
                android:textColor="@color/sand"
                android:textSize="14sp" />

            <View android:layout_width="10dp" android:layout_height="1dp" />

            <TextView
                android:id="@+id/release_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/slate"
                android:gravity="center"
                android:minHeight="64dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="Release call audio"
                android:textColor="@color/sand"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/call_audio_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/slate_ink"
            android:textSize="12sp"
            android:fontFamily="monospace" />

        

        

        

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Volume"
            android:textColor="@color/sand"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Android has no per-speaker volume. Calls and music are separate streams with separate levels — a routed call can be inaudible because its stream is low."
            android:textColor="@color/slate_ink"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/volume_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Patch bay"
            android:textColor="@color/sand"
            android:textSize="16sp" />

        <!-- Destination names, above the columns they belong to. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="from  \\  to"
                android:textColor="@color/slate_ink"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/patch_headers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/patch_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/patch_legend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/slate_ink"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="What this phone allows"
            android:textColor="@color/sand"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/probe_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <!-- §7: everything is arrangeable, and it resets. Two ends and a middle. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Which outputs to list"
                android:textColor="@color/sand"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/arrange_reset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Reset"
                android:textColor="@color/amber"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/arrange_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Balance"
            android:textColor="@color/sand"
            android:textSize="16sp" />

        <SeekBar
            android:id="@+id/balance_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="200" />

        <TextView
            android:id="@+id/balance_reset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/slate"
            android:gravity="center"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="Centre the balance"
            android:textColor="@color/sand"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/balance_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:text="Mantra Productions"
            android:textColor="@color/slate_ink"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
