<?xml version="1.0" encoding="utf-8"?>
<!--
  One channel: its glyph, its name, and a slider whose thumb carries the number — with a
  key-preview bubble that rises above the finger while dragging, because the finger is sitting
  on the one number being changed.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/volume_glyph"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/volume_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:textColor="@color/sand"
            android:textSize="20sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!--
          Reserved space at the top so the bubble has somewhere to go. It is INVISIBLE rather
          than GONE at rest: gone would collapse the row and every slider on screen would jump
          the moment a finger touched one.
        -->
        <TextView
            android:id="@+id/volume_bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:background="@drawable/bubble_bg"
            android:gravity="center"
            android:minWidth="84dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textColor="@color/ground"
            android:textSize="34sp"
            android:textStyle="bold"
            android:visibility="invisible" />

        <SeekBar
            android:id="@+id/volume_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginTop="64dp"
            android:max="100"
            android:progressDrawable="@drawable/slider_track"
            android:splitTrack="false"
            android:thumbOffset="0dp" />
    </FrameLayout>
</LinearLayout>
