<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- setCommunicationDevice and reading the audio device list. Normal permission. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!--
      The ONLY permission the Quick Settings tiles need, and it is a normal user-grantable
      special access - no Shizuku, no adb, no computer.

      setStreamVolume() itself needs nothing. It throws SecurityException in exactly one case:
      Do Not Disturb is on and the app cannot touch notification policy. That affects the Ring
      and Notification tiles. This makes those work too, granted from Settings on the phone.
    -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Without this the platform reports Bluetooth outputs with an empty name and address,
         which is what turns two pairs of earbuds into one unnameable row. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Declared so `pm grant` has something to move. It is signature|privileged and is
         expected to stay ungranted; the probe records the refusal rather than assuming it. -->
    <!-- The app-op probe came back "default" on Android 36: set silently did nothing. An
         app-op is attached to a permission the package DECLARES; without this line there was
         nothing for `appops set` to attach to. Declared so the grant has a target. -->
    <uses-permission
        android:name="android.permission.MEDIA_ROUTING_CONTROL"
        tools:ignore="ProtectedPermissions" />

    <uses-permission
        android:name="android.permission.MODIFY_AUDIO_ROUTING"
        tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MantraRoute">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The Quick Settings tile. TILE=false so it is not force-added; it is placed by
             hand from the pencil / edit button in the Quick Settings panel. -->


        <!-- Not a listener in any real sense: it reads nothing and overrides nothing. It
             exists so `cmd notification allow_listener` has a component to allow, which is
             the only way to learn which app is playing without a privileged permission. -->

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />


        <!-- Five Quick Settings tiles, one per volume stream, each toggling 50% / 100%.
             Android requires a distinct class per tile, hence five services over one. -->
        <service
            android:name=".CallVolumeTileService"
            android:exported="true"
            android:icon="@drawable/ic_stream_call"
            android:label="Call volume"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>

        <service
            android:name=".MediaVolumeTileService"
            android:exported="true"
            android:icon="@drawable/ic_stream_media"
            android:label="Media volume"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>

        <service
            android:name=".RingVolumeTileService"
            android:exported="true"
            android:icon="@drawable/ic_stream_ring"
            android:label="Ring volume"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>

        <service
            android:name=".NotificationVolumeTileService"
            android:exported="true"
            android:icon="@drawable/ic_stream_notification"
            android:label="Notification volume"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>

        <service
            android:name=".AlarmVolumeTileService"
            android:exported="true"
            android:icon="@drawable/ic_stream_alarm"
            android:label="Alarm volume"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>

    </application>
</manifest>
