<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- setCommunicationDevice and reading the audio device list. Normal permission. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!--
      The ONLY permission the Quick Settings tiles need, and it is a normal user-grantable
      special access - no Shizuku, no adb, no computer.

      setStreamVolume() itself needs nothing. It throws SecurityException in exactly one case:
      Do Not Disturb is on and the app cannot touch notification policy. That affects the Ring
      and Notification tiles. This makes those work too, granted from Settings on the phone.
    -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!--
      RECORD_AUDIO is here for the VU METER, and for nothing else.

      A meter of the system output reads it through Visualizer on the global session, and
      Android guards that with the microphone permission because the same API could be pointed
      at a microphone. This app never opens one, never records and never writes audio anywhere;
      the only consumer is the peak number the bar is drawn from.

      It is worth being blunt about, because "an audio app wants the microphone" is exactly the
      request a person should be suspicious of.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Without this the platform reports Bluetooth outputs with an empty name and address,
         which is what turns two pairs of earbuds into one unnameable row. -->

    <!-- Declared so `pm grant` has something to move. It is signature|privileged and is
         expected to stay ungranted; the probe records the refusal rather than assuming it. -->


    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MantraRoute">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The Quick Settings tile. TILE=false so it is not force-added; it is placed by
             hand from the pencil / edit button in the Quick Settings panel. -->


        <!-- Not a listener in any real sense: it reads nothing and overrides nothing. It
             exists so `cmd notification allow_listener` has a component to allow, which is
             the only way to learn which app is playing without a privileged permission. -->




        <!-- Ten Quick Settings tiles: five streams x two toggle pairs.
             The label is what the tile PICKER shows, so it carries the pair - otherwise
             two tiles for the same stream are indistinguishable while choosing. -->
        <service
            android:name=".CallVolumeTileService"
            android:exported="true"
            android:icon="@drawable/ic_stream_call"
            android:label="Call volume 100 / 50"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>

        <service
            android:name=".CallQuietVolumeTileService"
            android:exported="true"
            android:icon="@drawable/ic_stream_call"
            android:label="Call volume 50 / 25"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>

        <service
            android:name=".MediaVolumeTileService"
            android:exported="true"
            android:icon="@drawable/ic_stream_media"
            android:label="Media volume 100 / 50"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>

        <service
            android:name=".MediaQuietVolumeTileService"
            android:exported="true"
            android:icon="@drawable/ic_stream_media"
            android:label="Media volume 50 / 25"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>

        <service
            android:name=".RingVolumeTileService"
            android:exported="true"
            android:icon="@drawable/ic_stream_ring"
            android:label="Ring volume 100 / 50"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>

        <service
            android:name=".RingQuietVolumeTileService"
            android:exported="true"
            android:icon="@drawable/ic_stream_ring"
            android:label="Ring volume 50 / 25"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>

        <service
            android:name=".NotificationVolumeTileService"
            android:exported="true"
            android:icon="@drawable/ic_stream_notification"
            android:label="Notification volume 100 / 50"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>

        <service
            android:name=".NotificationQuietVolumeTileService"
            android:exported="true"
            android:icon="@drawable/ic_stream_notification"
            android:label="Notification volume 50 / 25"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>

        <service
            android:name=".AlarmVolumeTileService"
            android:exported="true"
            android:icon="@drawable/ic_stream_alarm"
            android:label="Alarm volume 100 / 50"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>

        <service
            android:name=".AlarmQuietVolumeTileService"
            android:exported="true"
            android:icon="@drawable/ic_stream_alarm"
            android:label="Alarm volume 50 / 25"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>

    </application>
</manifest>
